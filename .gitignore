# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# RFQ / contact submissions and uploads (never commit customer data)
/.data/
/.data-e2e/

# media working files: raw source footage, previews, renders, QA captures
# (regenerate with `npm run media:build`; see docs/ASSETS.md)
/media-src/

# playwright
/test-results/
/playwright-report/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
