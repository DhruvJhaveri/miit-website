# ─────────────────────────────────────────────────────────────
# MIIT CORPORATION website — environment variables
# Copy to .env.local (local) or set in your host's dashboard.
# Never commit real values. NEXT_PUBLIC_* values are exposed to browsers.
# ─────────────────────────────────────────────────────────────

# Public site URL (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.miitcorporation.com

# Company contact overrides (defaults come from src/content/company.ts)
NEXT_PUBLIC_COMPANY_EMAIL=miitcorporation@gmail.com
# WhatsApp CTAs appear only when this is set to a VERIFIED number, digits with country code
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Show the four company metrics (50+ years, 50+ partners, 1000+ products, 100+ customers)
# only after MIIT has approved their wording. "true" to enable.
NEXT_PUBLIC_SHOW_METRICS=false

# ── RFQ / contact delivery ───────────────────────────────────
# A submission is confirmed to the visitor only if at least ONE channel succeeds.

# 1) Local disk persistence (default on). Use "off" on serverless hosts without a durable disk.
RFQ_STORAGE=on
# Absolute or relative directory OUTSIDE /public. Default: ./.data
RFQ_STORAGE_DIR=
# Max RFQ submissions per client IP per 10 minutes (default 5)
RFQ_RATE_LIMIT=5

# 2) Email notifications via Resend (https://resend.com). Both values required to enable.
RESEND_API_KEY=
NOTIFY_EMAIL_TO=miitcorporation@gmail.com
# Must be a sender on a domain verified in Resend, e.g. "MIIT Website <rfq@miitcorporation.com>"
NOTIFY_EMAIL_FROM=
# "true" to send customers an acknowledgement email with their reference number
SEND_CUSTOMER_ACK=false

# 3) Odoo CRM lead creation (optional; verify first with `npm run odoo:check`)
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=

# 4) Generic outbound webhook (optional): JSON payload without file contents
SUBMISSION_WEBHOOK_URL=
WEBHOOK_SECRET=

# ── Spam protection (optional) ───────────────────────────────
# Cloudflare Turnstile. Set both to enable the widget and server verification.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Analytics (optional, consent-gated) ──────────────────────
# Google Tag Manager container ID, e.g. GTM-XXXXXXX. Leave empty to disable analytics entirely.
NEXT_PUBLIC_GTM_ID=
